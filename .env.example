# Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
# SHOP_AGENT_MODEL=claude-opus-5-5
# SHOP_AGENT_EFFORT=low        # low | medium | high

# Sarvam AI speech-to-text — https://dashboard.sarvam.ai
SARVAM_API_KEY=
# SARVAM_LANGUAGE=unknown      # auto-detect, or hi-IN, bn-IN, ta-IN, mr-IN, ...
# SARVAM_MODE=codemix          # transcribe | codemix | translit | translate

# WhatsApp Cloud API — Meta developer dashboard > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=           # App settings > Basic; enables webhook signature checks
# GRAPH_API_VERSION=v23.0

# Only these numbers may use the bot (country code, no +). Empty = anyone.
ALLOWED_NUMBERS=

# DB_PATH=shop.db
# TIMEZONE=Asia/Kolkata
